module Melee.Masks exposing (Mask, get, opaque, overlap)

{-| Original sprite collision masks generated from the UQM PNG alpha channels.
Coordinates and anchors are native display pixels, independent of presentation quality.
-}

import Array exposing (Array)
import Dict


type alias Mask =
    { width : Int, height : Int, x : Int, y : Int, rows : Array (List ( Int, Int )) }


get : String -> Maybe Mask
get path =
    Dict.get path masks


opaque : Mask -> Int -> Int -> Bool
opaque mask x y =
    Array.get (y + mask.y) mask.rows |> Maybe.map (List.any (\( a, b ) -> x + mask.x >= a && x + mask.x <= b)) |> Maybe.withDefault False


overlap : Mask -> Mask -> Int -> Int -> Bool
overlap a b dx dy =
    let
        left =
            dx + a.x - b.x

        top =
            dy + a.y - b.y

        first =
            max 0 top

        last =
            min (a.height - 1) (top + b.height - 1)

        row y =
            let
                ar =
                    Array.get y a.rows |> Maybe.withDefault []

                br =
                    Array.get (y - top) b.rows |> Maybe.withDefault []
            in
            List.any (\( x0, x1 ) -> List.any (\( z0, z1 ) -> x0 <= z1 + left && x1 >= z0 + left) br) ar
    in
    left < a.width && left + b.width > 0 && first <= last && List.any row (List.range first last)


