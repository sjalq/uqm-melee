type alias Sprite =
    { path : String, width : Int, height : Int }


projectile : Body -> Int -> Maybe Sprite
projectile body frame =
    case body of
        WeaponImpact missile ->
            projectile (Arsenal.missileBody missile) 0 |> Maybe.map (\sprite -> { sprite | path = (String.split "-big-" sprite.path |> List.head |> Maybe.withDefault "") ++ "-big-" ++ String.padLeft 3 '0' (String.fromInt frame) ++ ".png" })

        UmgahCone ->
            Just { path = "/ships/umgah/cone-big-" ++ String.padLeft 3 '0' (String.fromInt (modBy 48 frame)) ++ ".png", width = 1, height = 1 }

        ZoqTongue ->
            Just { path = "/ships/zoqfotpik/proboscis-big-" ++ String.padLeft 3 '0' (String.fromInt (modBy 16 frame)) ++ ".png", width = 1, height = 1 }

