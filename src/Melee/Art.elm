ship : Combatant -> Int -> String
ship combatant facing =
    let
        frame =
            String.padLeft 3 '0' (String.fromInt (modBy 16 facing))
    in
    case combatant of
        LiveAndrosynth _ (Blazer _) ->
            "/ships/androsynth/blazer-big-" ++ frame ++ ".png"

        LiveMmrnmhrm _ extra ->
            if extra.form == YWing then
                "/ships/mmrnmhrm/ywing-big-" ++ frame ++ ".png"

            else
                Catalog.sprite (kind combatant) facing

        _ ->
            Catalog.sprite (kind combatant) facing


