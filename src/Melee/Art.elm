portraitLayers : Combatant -> List String
portraitLayers combatant =
    let
        c =
            core combatant

        turn =
            case c.input.turn of
                TurnLeft ->
                    5

                TurnRight ->
                    1

                NoTurn ->
                    3

        path index =
            String.replace "-big-" ("-cap-" ++ String.padLeft 3 '0' (String.fromInt index) ++ ".png") (Catalog.info (kind combatant)).sprite
    in
    List.map path
        [ turn
        , if c.input.thrust then
            8

          else
            6
        , if c.input.weapon then
            11

          else
            9
        , if c.input.special then
            14

          else
            12
        ]
        |> List.filter (\file -> Dict.member file stamps)
