portrait : Combatant -> String
portrait combatant =
    let
        base =
            (Catalog.info (kind combatant)).sprite
    in
    String.replace "-big-" "-cap-000.png" base


schematic : Combatant -> String
schematic combatant =
    let
        base =
            (Catalog.info (kind combatant)).sprite
    in
    String.replace "-big-" "-icons-001.png" base


captain : Combatant -> String
captain combatant =
    Dict.get (Catalog.info (kind combatant)).sprite captainNames |> Maybe.withDefault "Captain"


